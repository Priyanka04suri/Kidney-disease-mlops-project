name: workflow

on:
  push:
    branches:
      - main
    paths-ignore:
      - 'README.md'

permissions:
  contents: read

env:
  IMAGE_NAME: my-app
  IMAGE_TAG: latest

jobs:

  # -------------------------------
  # 1. Continuous Integration
  # -------------------------------
  integration:
    name: Continuous Integration
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Set up Python (if ML project)
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          pip install -r requirements.txt

      - name: Lint Code
        run: |
          echo "Linting..."
          # Example:
          # pip install flake8
          # flake8 .

      - name: Run Unit Tests
        run: |
          echo "Running tests..."
          # pytest

  # -------------------------------
  # 2. Build Stage (Docker)
  # -------------------------------
  build:
    name: Build Docker Image
    needs: integration
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Build Docker Image
        run: |
          docker build -t $IMAGE_NAME:$IMAGE_TAG .

      - name: Save Docker Image (Artifact)
        run: |
          docker save $IMAGE_NAME:$IMAGE_TAG > image.tar

      - name: Upload Artifact
        uses: actions/upload-artifact@v3
        with:
          name: docker-image
          path: image.tar

  # -------------------------------
  # 3. Security Scan (Optional but Pro)
  # -------------------------------
  security-scan:
    name: Security Scan
    needs: build
    runs-on: ubuntu-latest

    steps:
      - name: Download Image Artifact
        uses: actions/download-artifact@v3
        with:
          name: docker-image

      - name: Load Docker Image
        run: |
          docker load < image.tar

      - name: Scan Image (Basic)
        run: |
          echo "Scanning Docker image for vulnerabilities..."
          # You can integrate Trivy here:
          # sudo apt install trivy
          # trivy image $IMAGE_NAME:$IMAGE_TAG

  # -------------------------------
  # 4. Continuous Deployment (Render)
  # -------------------------------
  deploy:
    name: Deploy to Render
    needs: security-scan
    runs-on: ubuntu-latest

    steps:
      - name: Trigger Render Deployment
        run: |
          curl -X POST ${{ secrets.RENDER_DEPLOY_HOOK_URL }}

  # -------------------------------
  # 5. Post Deployment Check
  # -------------------------------
  post-deploy:
    name: Health Check
    needs: deploy
    runs-on: ubuntu-latest

    steps:
      - name: Check Application Health
        run: |
          echo "Checking if app is live..."
          # Replace with your Render URL
          curl -f https://your-app.onrender.com || exit 1